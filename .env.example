# Estas variables las inyecta automáticamente Vercel Postgres cuando
# conectás el Storage a este proyecto (Storage → Create Database → Postgres).
# Para desarrollo local, copiá los valores desde:
# Vercel dashboard → tu proyecto → Storage → tu base → ".env.local" tab
POSTGRES_PRISMA_URL="postgresql://usuario:password@host/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://usuario:password@host/db?sslmode=require"

# --- Agente de WhatsApp (opcional) — ver docs/WHATSAPP_AGENT.md ---
# Sin estas variables el webhook /api/whatsapp/webhook responde 503 y no hace nada.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Quiénes pueden hablarle al agente: número (código de país, sin +) : nombre
WHATSAPP_ALLOWED_NUMBERS="595981111111:Nombre Apellido"
ANTHROPIC_API_KEY=""
# Opcionales:
# WHATSAPP_GRAPH_VERSION="v25.0"
# ANTHROPIC_MODEL="claude-sonnet-5"   # para máxima precisión: claude-opus-5-5
# ANTHROPIC_EFFORT="medium"
# APP_BASE_URL="https://obrasflow-app.vercel.app"
# NEXT_PUBLIC_CONTACT_EMAIL=""        # correo que muestran /privacidad y /terminos
# Solo para el script de configuración (npm run wa -- ayuda). Los secretos van en
# .env.local, que git ignora — nunca en un archivo .env.* sin ".local":
# WHATSAPP_WABA_ID=""                 # se detecta solo desde el token si hay una sola WABA
# WHATSAPP_WEBHOOK_URL="https://obrasflow-app.vercel.app/api/whatsapp/webhook"
