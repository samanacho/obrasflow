# Estas variables las inyecta automáticamente Vercel Postgres cuando
# conectás el Storage a este proyecto (Storage → Create Database → Postgres).
# Para desarrollo local, copiá los valores desde:
# Vercel dashboard → tu proyecto → Storage → tu base → ".env.local" tab
POSTGRES_PRISMA_URL="postgresql://usuario:password@host/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://usuario:password@host/db?sslmode=require"

# --- Agente de WhatsApp (opcional) — ver docs/WHATSAPP_AGENT.md ---
# Sin estas variables el webhook /api/whatsapp/webhook responde 503 y no hace nada.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Quiénes pueden hablarle al agente: número (código de país, sin +) : nombre
WHATSAPP_ALLOWED_NUMBERS="595981111111:Nombre Apellido"
ANTHROPIC_API_KEY=""
# Opcionales:
# WHATSAPP_GRAPH_VERSION="v25.0"
# ANTHROPIC_MODEL="claude-sonnet-5"   # para máxima precisión: claude-opus-5-5
# ANTHROPIC_EFFORT="medium"
# APP_BASE_URL="https://obrasflow-app.vercel.app"
# NEXT_PUBLIC_CONTACT_EMAIL=""        # correo que muestran /privacidad y /terminos
# Solo para el script de configuración (npm run wa -- ayuda). Los secretos van en
# .env.local, que git ignora — nunca en un archivo .env.* sin ".local":
# WHATSAPP_WABA_ID=""                 # se detecta solo desde el token si hay una sola WABA
# WHATSAPP_WEBHOOK_URL="https://obrasflow-app.vercel.app/api/whatsapp/webhook"

# --- Conexión por QR (Baileys) — la que usa el agente por defecto ---
# En Vercel: WHATSAPP_PANEL_KEY (clave de la pantalla Agente WhatsApp; generala ahí mismo).
# En la PC del conector (.env.local, nunca en git): POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING,
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL, ANTHROPIC_EFFORT, WHATSAPP_ALLOWED_NUMBERS y
# APP_BASE_URL="https://obrasflow-app.vercel.app". Después: npm run wa:conector
# WHATSAPP_PANEL_KEY=""
# WHATSAPP_PROVIDER="baileys"   # "cloud" para usar la API oficial de Meta

# --- Integración con Residente de Obra (opcional) — ver docs/RESPUESTA_HANDOFF_RESIDENTE_DE_OBRA.md ---
# Sin el secreto, el webhook /api/integraciones/residente-de-obra/webhook responde 503.
RESIDENTE_WEBHOOK_SECRET=""
# API de ellos (todavía no existe): solo hace falta si el webhook trae únicamente el id del parte.
RESIDENTE_API_URL=""
RESIDENTE_API_KEY=""

# --- Compras: grupo de WhatsApp de pedidos (conector de la PC, worker/) ---
# Nombre exacto del grupo donde obra manda los "Pedido de compra" (Memby solo lee ese grupo).
# MEMBY_GRUPO_COMPRAS="Pedidos de compra"
# Apagar la lectura del grupo:
# MEMBY_COMPRAS=off
# Modelo para entender pedidos escritos a mano alzada (solo con ANTHROPIC_API_KEY; con Claude Code usa CLAUDE_CLI_MODEL):
# MEMBY_COMPRAS_MODEL=claude-haiku-4-5
# Número que aprueba los pedidos (recibe la tarjeta Sí/No y los avisos de facturas). Sin esto, el chat "Tú" de la cuenta vinculada.
# MEMBY_APROBADOR=595981111111

# --- Pantalla Personal (reparto de beneficios) — ver lib/auth/personal.ts ---
# Usuarios de ingreso que pueden verla, separados por coma. Para los demás no
# existe (ni en el menú). Sin definir: solo el primer usuario creado que siga
# activo. En la app local de la PC se ve siempre.
# PERSONAL_USUARIOS="usuario1,usuario2"
