generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel Postgres (Storage → Create Database) inyecta estas variables
  // automáticamente en el proyecto; POSTGRES_PRISMA_URL va con pooling
  // (pgbouncer) para runtime, POSTGRES_URL_NON_POOLING es la directa,
  // usada solo para migraciones.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum ProjectType {
  civil
  electrico
  vial
  otro
}

enum ProjectStatus {
  planificado
  en_curso
  pausado
  finalizado
}

enum ProjectSector {
  privado
  publico
}

model Project {
  id          String         @id @default(cuid())
  name        String
  /// Referencia corta para distinguir obras que de otro modo se ven
  /// idénticas en las tarjetas (mismo tipo, ciudad, responsable y hasta
  /// presupuesto) — ej. "Sucursal Norte", "Lote 3", "Fase 2". Puramente
  /// identificatoria, no afecta ningún cálculo.
  reference   String?
  type        ProjectType
  /// Rubro escrito a mano cuando `type` es "otro" — null para el resto.
  customType  String?
  status      ProjectStatus  @default(planificado)
  manager     String
  /// Ciudad donde se ejecuta la obra — distinto de sectorData.localidad
  /// (lista de ciudades para trámites de licitación pública): esto es la
  /// ubicación general de la obra, un solo valor, para cualquier sector.
  city        String?
  /// Departamento de esa ciudad — ver lib/departments.ts (lista fija, los
  /// 17 departamentos de Paraguay + Asunción capital).
  department  String?
  /// "lat,lng" del pin en el mapa — mismo formato que ProjectItem.data.coordenadas (Relevamiento).
  coordinates String?
  start       DateTime       @db.Date
  end         DateTime       @db.Date
  budget      Decimal        @default(0) @db.Decimal(14, 2)
  spent       Decimal        @default(0) @db.Decimal(14, 2)
  progress    Int            @default(0)
  /// Privado o público — null en proyectos creados antes de este campo.
  sector      ProjectSector?
  /// Respuestas del paso 3 del wizard (varían según `sector`): para
  /// público incluye entidadConvocante/nombreLicitacion/procedimiento +
  /// extras; para privado, los campos de client-intake. JSON en vez de
  /// columnas propias porque el set de campos es específico del sector y
  /// se decide/ajusta desde la config del wizard, no desde el schema.
  sectorData  Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items ProjectItem[]

  @@index([status])
  @@index([type])
}

/// Registro genérico para los módulos secundarios de un proyecto (RFIs,
/// punch list, bitácora diaria, órdenes de cambio, equipo, checklist,
/// hitos, documentos, fotos, partidas de presupuesto y el feed de
/// actividad). `kind` distingue el módulo; `data` guarda los campos
/// propios de cada uno como JSON — evita una tabla por módulo para un
/// set de features que comparten el mismo patrón CRUD.
model ProjectItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  status    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([projectId, kind])
}

/// Archivo adjunto real (foto o PDF de un comprobante, por ahora) — un
/// registro guarda como mucho uno a la vez, ver app/api/items/[itemId]/
/// attachment/route.ts. Se guarda el contenido directo en la base
/// (Bytes/bytea) en vez de un servicio externo tipo Vercel Blob: no hay
/// credenciales de storage configuradas en este proyecto todavía, así que
/// esto funciona sin depender de una configuración manual nueva — la
/// contrapartida es un límite práctico de tamaño por archivo (ver el
/// límite de 4MB validado en la propia ruta de subida).
model Attachment {
  id            String      @id @default(cuid())
  projectItemId String
  projectItem   ProjectItem @relation(fields: [projectItemId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime    @default(now())

  @@index([projectItemId])
}

enum ContractorStatus {
  activo
  inactivo
}

/// Directorio global de contratistas (no pertenece a ningún proyecto en
/// particular — se reutiliza entre obras de distinto rubro y ciudad para
/// poder comparar opciones antes de contratar).
model Contractor {
  id          String           @id @default(cuid())
  name        String
  ruc         String?
  contactName String?
  phone       String?
  email       String?
  city        String?
  /// Ver lib/departments.ts — los 17 departamentos de Paraguay + Asunción capital, mismo criterio que Project.department.
  department  String?
  /// Calificación general del contratista, puesta a mano (1-5) — distinta
  /// del promedio calculado por obra en ContractorHistoryEntry.rating: esa
  /// requiere cargar un historial completo por cada obra trabajada, esto
  /// es una calificación directa y rápida. La ficha usa esta si está
  /// cargada, y si no cae al promedio del historial.
  rating      Int?
  rubros      ProjectType[]
  status      ContractorStatus @default(activo)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  history ContractorHistoryEntry[]

  @@index([status])
}

enum SupplierCategory {
  materiales
  servicios
}

/// Directorio global de proveedores (materiales de obra y/o servicios) —
/// distinto de Contractor: un contratista EJECUTA trabajo, un proveedor
/// VENDE materiales o presta un servicio (alquiler de maquinaria, por
/// ejemplo). Se usa como selector en la Ejecución de una obra cuando el
/// movimiento es de tipo "Materiales" o "Maquinaria / Alquileres" — ver
/// lib/itemKinds.ts.
model Supplier {
  id          String             @id @default(cuid())
  name        String
  ruc         String?
  contactName String?
  phone       String?
  email       String?
  city        String?
  /// Ver lib/departments.ts.
  department  String?
  categories  SupplierCategory[]
  status      ContractorStatus   @default(activo)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tools Tool[]

  @@index([status])
}

enum GeneralMovementTipo {
  ingreso
  egreso
}

/// Movimientos de caja de la empresa que NO están ligados a ninguna obra
/// puntual — ej. un ingreso por un servicio aparte, un gasto administrativo
/// general, intereses bancarios. A diferencia de los movimientos de obra
/// (ProjectItem kind="change_order", siempre cargados desde la ficha de la
/// obra), estos se cargan y editan directamente desde /movimientos. Su neto
/// (ingresos menos egresos) se suma al "Costos vs. beneficios" de Inicio —
/// ver app/page.tsx.
model GeneralMovement {
  id           String              @id @default(cuid())
  fecha        DateTime            @db.Date
  tipo         GeneralMovementTipo
  concepto     String
  categoria    String?
  monto        Decimal             @db.Decimal(14, 2)
  medioPago    String?
  /// Mismo vocabulario que los movimientos de obra: "Pendiente" | "Pagado" | "Conciliado".
  estado       String?
  procesadoPor String?
  notas        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  /// Presente cuando este movimiento fue generado automáticamente por la
  /// adquisición de una herramienta (ver Tool.generalMovement) — al borrar
  /// el movimiento desde /movimientos, la herramienta simplemente pierde el
  /// enlace (no se borra ella).
  tool Tool?

  @@index([fecha])
}

enum ToolStatus {
  disponible
  en_uso
  en_reparacion
  de_baja
}

/// Inventario de herramientas y equipos de la empresa — directorio global,
/// no ligado a ninguna obra puntual (como Proveedores/Contratistas). Si se
/// carga con costoUnitarioGs, se genera/sincroniza automáticamente un
/// GeneralMovement (egreso, monto = costoUnitarioGs * cantidad) enlazado
/// vía generalMovementId — ver app/api/tools/route.ts y [id]/route.ts.
model Tool {
  id                String           @id @default(cuid())
  nombre            String
  /// Texto libre con sugerencias (no un catálogo cerrado) — ver TOOL_CATEGORY_SUGGESTIONS en el frontend.
  categoria         String?
  marcaModelo       String?
  cantidad          Int              @default(1)
  estado            ToolStatus       @default(disponible)
  costoUnitarioGs   Decimal?         @db.Decimal(14, 2)
  proveedorId       String?
  proveedor         Supplier?        @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  fechaAdquisicion  DateTime?        @db.Date
  /// Quién la tiene o dónde está guardada — texto libre.
  responsable       String?
  notas             String?
  /// Movimiento general (egreso) generado automáticamente por esta adquisición — null si no se cargó costo.
  generalMovementId String?          @unique
  generalMovement   GeneralMovement? @relation(fields: [generalMovementId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([estado])
}

/// Una entrada por cada obra trabajada junto al contratista, con su propia
/// calificación 1-5 (el promedio se calcula en la app a partir de estas
/// entradas, no se guarda como campo aparte).
model ContractorHistoryEntry {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  obraNombre   String
  projectId    String?
  rating       Int?
  comentario   String?
  fecha        DateTime?  @db.Date
  createdAt    DateTime   @default(now())

  @@index([contractorId])
}

// ── Fábrica de Postes ───────────────────────────────────────────────────
// Dominio completamente aparte de las obras (es control de producción de
// fábrica, no gestión de proyectos de construcción) — por eso son modelos
// relacionales propios en vez de reusar el patrón ProjectItem/data-JSON:
// acá los campos SÍ son fijos y conocidos de antemano (longitud, esfuerzo,
// resultado de ensayo...), no un formulario configurable por módulo.

enum PoleLotStatus {
  en_curado
  listo_para_ensayo
  en_ensayo
  aprobado
  rechazado
  despachado
}

/// Catálogo de especificaciones técnicas de poste — el usuario carga acá
/// los tipos que realmente produce (longitud, esfuerzo nominal, diámetro,
/// calidad del hormigón). No se hardcodean clases "oficiales" de ANDE en
/// el código: la nomenclatura exacta de clases varía y hay que cargarla
/// real, no inventada — ver lib/poleFields.ts para el detalle de por qué.
model PoleSpec {
  id                  String   @id @default(cuid())
  nombre              String
  longitud            Decimal  @db.Decimal(5, 2)
  esfuerzoNominal     Decimal  @db.Decimal(8, 2)
  diametroBase        Decimal? @db.Decimal(6, 2)
  resistenciaHormigon String?
  armadura            String?
  normaAnde           String?
  notas               String?
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lots        PoleLot[]
  recipeItems PoleRecipeItem[]

  @@index([activo])
}

/// Un lote de producción: una tanda de postes de una misma especificación,
/// coladas juntas, que recorren el mismo ciclo de curado -> ensayo ->
/// aprobación ANDE -> despacho.
model PoleLot {
  id                 String        @id @default(cuid())
  specId             String
  spec               PoleSpec      @relation(fields: [specId], references: [id])
  codigo             String
  cantidad           Int
  /// Postes del lote reservados para ensayo destructivo — no se entregan.
  /// Default 1: la fábrica produce 101 postes por lote porque son 100 los
  /// que hay que entregar y uno se rompe el día de la fiscalización por
  /// las pruebas a las que se somete. El "disponible para despacho" real
  /// es `cantidad - cantidadParaEnsayo - cantidadDespachada`.
  cantidadParaEnsayo Int           @default(1)
  /// Cuántos de los `cantidad` ya salieron despachados.
  cantidadDespachada Int           @default(0)
  fechaColado        DateTime      @db.Date
  fechaDesmolde      DateTime?     @db.Date
  estado             PoleLotStatus @default(en_curado)
  responsable        String?
  /// Ciudad a la que se debe enviar este lote.
  ciudadDestino      String?
  andeAprobado       Boolean       @default(false)
  andeFecha          DateTime?     @db.Date
  andeActa           String?
  andeInspector      String?
  /// Numeración asignada por la ANDE a los postes entregados de este lote
  /// — texto libre (ej. un rango) porque no siempre son números consecutivos.
  numeracionAnde     String?
  notas              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tests                PoleQualityTest[]
  materialConsumptions PoleLotMaterialConsumption[]

  @@index([specId])
  @@index([estado])
}

/// Catálogo de materias primas (cemento, hierro, alambre, arena...) que
/// entran en las recetas de los postes. `costoUnitarioGs` es el precio
/// "de mercado actual" en guaraníes — se edita a mano cuando cambia. Cada
/// consumo de lote (PoleLotMaterialConsumption) guarda una copia congelada
/// de este costo al momento de producir, así el costo histórico de un lote
/// ya hecho no se mueve cuando el precio de hoy cambia.
model RawMaterial {
  id              String   @id @default(cuid())
  nombre          String
  /// Unidad de medida libre: "kg", "m", "m³", "litro", "bolsa", "unidad"...
  unidad          String
  costoUnitarioGs Decimal  @db.Decimal(14, 2)
  proveedor       String?
  notas           String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems  PoleRecipeItem[]
  consumptions PoleLotMaterialConsumption[]
  purchases    MaterialPurchase[]

  @@index([activo])
}

enum PurchaseDocType {
  factura
  orden_compra
  remision
  otro
}

/// Registro de compra de materia prima — trazabilidad de qué se compró,
/// cuándo, a quién y con qué documento (factura/orden de compra/remisión).
/// Sin onDelete Cascade desde RawMaterial a propósito: es un registro real
/// de compra, igual que PoleLot/PoleQualityTest — bloquea el borrado del
/// material en vez de desaparecer con él (ver lib/prismaErrors.ts).
model MaterialPurchase {
  id              String          @id @default(cuid())
  materialId      String
  material        RawMaterial     @relation(fields: [materialId], references: [id])
  fecha           DateTime        @db.Date
  cantidad        Decimal         @db.Decimal(12, 4)
  costoUnitarioGs Decimal         @db.Decimal(14, 2)
  costoTotalGs    Decimal         @db.Decimal(16, 2)
  proveedor       String?
  tipoDocumento   PurchaseDocType @default(factura)
  numeroDocumento String?
  notas           String?
  createdAt       DateTime        @default(now())

  @@index([materialId])
  @@index([fecha])
}

/// Un ítem de la receta (BOM) de un tipo de poste: cuánta cantidad de una
/// materia prima entra en UN poste de esa especificación. La receta se
/// arma agregando materiales uno por uno desde la ficha de la especificación.
model PoleRecipeItem {
  id               String      @id @default(cuid())
  specId           String
  spec             PoleSpec    @relation(fields: [specId], references: [id], onDelete: Cascade)
  materialId       String
  material         RawMaterial @relation(fields: [materialId], references: [id])
  cantidadPorPoste Decimal     @db.Decimal(12, 4)
  notas            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([specId, materialId])
  @@index([materialId])
}

/// Consumo de materia prima de un lote ya producido. Se genera automático
/// a partir de la receta de la especificación en el momento en que se crea
/// el lote (cantidadPorPoste de la receta × cantidad de postes del lote),
/// con el costo unitario CONGELADO a ese momento — el costo de un lote no
/// cambia después aunque el precio de mercado del material se actualice.
/// Si se edita la cantidad de postes del lote, se recalcula la cantidad y
/// costo total consumido (con el mismo costo unitario ya congelado).
model PoleLotMaterialConsumption {
  id               String      @id @default(cuid())
  lotId            String
  lot              PoleLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  materialId       String
  material         RawMaterial @relation(fields: [materialId], references: [id])
  /// Snapshot del nombre/unidad de la receta al momento de producir.
  materialNombre   String
  unidad           String
  cantidadPorPoste Decimal     @db.Decimal(12, 4)
  costoUnitarioGs  Decimal     @db.Decimal(14, 2)
  cantidadTotal    Decimal     @db.Decimal(14, 4)
  costoTotalGs     Decimal     @db.Decimal(16, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([lotId])
  @@index([materialId])
}

/// Un ensayo de control de calidad sobre un lote (ruptura/flexión,
/// verificación dimensional, curado...). Varios ensayos por lote.
model PoleQualityTest {
  id            String   @id @default(cuid())
  lotId         String
  lot           PoleLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  tipo          String
  resultado     String
  fecha         DateTime @db.Date
  valorMedido   String?
  responsable   String?
  observaciones String?
  createdAt     DateTime @default(now())

  @@index([lotId])
}
