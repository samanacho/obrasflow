generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel Postgres (Storage → Create Database) inyecta estas variables
  // automáticamente en el proyecto; POSTGRES_PRISMA_URL va con pooling
  // (pgbouncer) para runtime, POSTGRES_URL_NON_POOLING es la directa,
  // usada solo para migraciones.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum ProjectType {
  civil
  electrico
  vial
  otro
}

enum ProjectStatus {
  planificado
  en_curso
  pausado
  finalizado
}

model Project {
  id        String        @id @default(cuid())
  name      String
  type      ProjectType
  status    ProjectStatus @default(planificado)
  manager   String
  start     DateTime      @db.Date
  end       DateTime      @db.Date
  budget    Decimal       @default(0) @db.Decimal(14, 2)
  spent     Decimal       @default(0) @db.Decimal(14, 2)
  progress  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items ProjectItem[]

  @@index([status])
  @@index([type])
}

/// Registro genérico para los módulos secundarios de un proyecto (RFIs,
/// punch list, bitácora diaria, órdenes de cambio, equipo, checklist,
/// hitos, documentos, fotos, partidas de presupuesto y el feed de
/// actividad). `kind` distingue el módulo; `data` guarda los campos
/// propios de cada uno como JSON — evita una tabla por módulo para un
/// set de features que comparten el mismo patrón CRUD.
model ProjectItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  status    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, kind])
}

enum ContractorStatus {
  activo
  inactivo
}

/// Directorio global de contratistas (no pertenece a ningún proyecto en
/// particular — se reutiliza entre obras de distinto rubro y ciudad para
/// poder comparar opciones antes de contratar).
model Contractor {
  id          String           @id @default(cuid())
  name        String
  ruc         String?
  contactName String?
  phone       String?
  email       String?
  city        String?
  province    String?
  rubros      ProjectType[]
  status      ContractorStatus @default(activo)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  history ContractorHistoryEntry[]

  @@index([status])
}

/// Una entrada por cada obra trabajada junto al contratista, con su propia
/// calificación 1-5 (el promedio se calcula en la app a partir de estas
/// entradas, no se guarda como campo aparte).
model ContractorHistoryEntry {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  obraNombre   String
  projectId    String?
  rating       Int?
  comentario   String?
  fecha        DateTime?  @db.Date
  createdAt    DateTime   @default(now())

  @@index([contractorId])
}
